{
  "balanced": {
    "summary": "The default. It trades a little score for a lot of cost on the roles that run often, and buys the top score on the few changes that hurt most.",
    "rules": {
      "code": {
        "where": {
          "passed": "all",
          "scoreWithin": 5
        },
        "pick": "min-usd"
      },
      "explore": {
        "pick": "min-minutes"
      },
      "judgment": {
        "where": {
          "safetyEvidence": true
        },
        "pick": "min-usd"
      },
      "hardest": {
        "pick": "max-score"
      },
      "reflect tooling": {
        "where": {
          "model": "gpt-6.1-sol"
        },
        "pick": "max-score"
      },
      "panels": {
        "per": "lab",
        "rosters": {
          "default": [
            "Anthropic",
            "OpenAI",
            "xAI"
          ]
        },
        "where": {
          "scoreWithin": 0.5
        },
        "pick": "min-usd"
      }
    },
    "pins": []
  },
  "budget": {
    "summary": "Spends as little as it can on the roles that run often. Code and exploration stay on the open DeepSeek model, judgment and the hardest changes keep the cheapest cell with a published cost and Safety v1 evidence, and the fan-out panels drop Opus. DeepSeek effort levels that the Droid run shows a cheaper level beating are skipped.",
    "rules": {
      "code": {
        "where": {
          "model": "deepseek-v4.1-flash",
          "droidDominated": false
        },
        "pick": "max-score"
      },
      "explore": {
        "pick": "min-usd"
      },
      "judgment": {
        "where": {
          "safetyEvidence": true
        },
        "pick": "min-usd"
      },
      "hardest": {
        "where": {
          "measuredUsd": true,
          "safetyEvidence": true
        },
        "pick": "min-usd"
      },
      "reflect tooling": {
        "where": {
          "model": "gpt-6.1-sol",
          "passed": "all"
        },
        "pick": "min-usd"
      },
      "panels": {
        "per": "lab",
        "rosters": {
          "default": [
            "OpenAI",
            "DeepSeek",
            "xAI"
          ],
          "arena cross-judge pool": [
            "Anthropic",
            "OpenAI",
            "xAI"
          ]
        },
        "rosterNote": "the runners are OpenAI, DeepSeek and xAI, so the cross-judge pool needs an outside lab",
        "where": {
          "scoreWithin": 1,
          "droidDominated": false
        },
        "pick": "min-usd"
      }
    },
    "pins": []
  },
